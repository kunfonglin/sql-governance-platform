name: deploy-test
on:
  push:
    branches: [development]

jobs:
  deploy:
    permissions:
      id-token: write
      contents: write
    uses: __PLATFORM_OWNER__/sql-governance-platform/.github/workflows/reusable-deploy.yml@__PLATFORM_REF__
    with:
      project_id: ${{ vars.PROJECT_TEST }}
      environment: test
      logical_project: __PROJECT_NAME__
      platform_repo: __PLATFORM_OWNER__/sql-governance-platform
      platform_ref: __PLATFORM_REF__
    secrets:
      WIF_PROVIDER: ${{ secrets.WIF_PROVIDER }}
      DEPLOY_SA: ${{ secrets.DEPLOY_SA }}
      TG_BOT_TOKEN: ${{ secrets.TG_BOT_TOKEN }}
      TG_CHAT_ID: ${{ secrets.TG_CHAT_ID }}
